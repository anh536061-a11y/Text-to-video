{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "ArcReel",
  "version": "0.0.1",
  "identifier": "com.arcreel.desktop",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devUrl": "http://127.0.0.1:1241",
    "frontendDist": "frontend-placeholder"
  },
  "app": {
    "windows": [
      {
        "title": "ArcReel",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "url": "http://127.0.0.1:1241/",
        "visible": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "ArcReel — AI video generation desktop app",
    "longDescription": "ArcReel is an AI video generation platform that turns novels into short videos. This desktop build bundles the Python backend, frontend, and ffmpeg into a single Windows installer.",
    "resources": {
      "../resources/python": "python",
      "../resources/app": "app",
      "../resources/ffmpeg": "ffmpeg"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["English", "Vietnamese", "SimpChinese"]
      },
      "wix": null
    }
  },
  "plugins": {}
}
